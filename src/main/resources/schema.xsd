<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xs:element name="SmartCityData">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="Vehicle" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="OffStreetParking" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="Vehicle">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="brandName" type="xs:string"/>
                <xs:element name="street" type="xs:string"/>
                <xs:element name="isParked">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="parkingId" type="xs:string"/>
                            <xs:element name="observedAt" type="xs:dateTime"/>
                            <xs:element name="providedBy" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="category" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="type" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="OffStreetParking">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:string"/>
                <xs:element name="coordinates">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="longitude" type="xs:double"/>
                            <xs:element name="latitude" type="xs:double"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="availableSpotNumber">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="value" type="xs:int"/>
                            <xs:element name="observedAt" type="xs:dateTime"/>
                            <xs:element name="reliability" type="xs:double"/>
                            <xs:element name="providedBy" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="totalSpotNumber" type="xs:int"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="type" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>